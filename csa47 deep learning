        "outputId": "a53bbb83-2578-4150-dc82-b94245c20b72"
      },
      "source": [
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "import seaborn as sns\n",
        "\n",
        "# Task 1: Build matrices in NumPy\n",
        "np.random.seed(42)\n",
        "\n",
        "# 6 customers rating 5 genres (values from 1 to 5)\n",
        "customer_genre = np.random.randint(1, 6, size=(6, 5)).astype(float)\n",
        "# 5 genres mapping to 4 books (weights between 0 and 1)\n",
        "genre_book = np.random.uniform(0.1, 1.0, size=(5, 4))\n",
        "\n",
        "print(\"Customer-Genre Matrix (6x5):\\n\", customer_genre)\n",
        "print(\"\\nGenre-Book Matrix (5x4):\\n\", np.round(genre_book, 2))"
