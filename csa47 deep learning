        "# Initialize weights\n",
        "def initialize(hidden=8):\n",
        "    W1 = np.random.randn(2, hidden) * np.sqrt(1/2)\n",
        "    b1 = np.zeros((1, hidden))\n",
        "    W2 = np.random.randn(hidden, 1) * np.sqrt(1/hidden)\n",
        "    b2 = np.zeros((1, 1))\n",
        "    return W1, b1, W2, b2\n",
        "\n",
        "# Task 2: Forward propagation\n",
        "def forward(X, W1, b1, W2, b2):\n",
        "    H = sigmoid(X @ W1 + b1)\n",
        "    Y = sigmoid(H @ W2 + b2)\n",
        "    return H, Y\n",
