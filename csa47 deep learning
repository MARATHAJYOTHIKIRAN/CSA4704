      "source": [
        "# Task 3: Compute cosine similarity between customers and identify the most similar pair\n",
        "\n",
        "def cosine_similarity_matrix(matrix):\n",
        "    norms = np.linalg.norm(matrix, axis=1, keepdims=True)\n",
        "    normalized_matrix = matrix / norms\n",
        "    similarity = np.dot(normalized_matrix, normalized_matrix.T)\n",
        "    return similarity\n",
        "\n",
        "similarity_matrix = cosine_similarity_matrix(customer_genre)\n",
        "print(\"Cosine Similarity Matrix between Customers (6x6):\\n\", np.round(similarity_matrix, 4))\n",
        "\n",
        "# Find the top two most similar (excluding self-similarity of 1.0 on diagonal)\n",
        "mask = np.eye(similarity_matrix.shape[0], dtype=bool)\n",
        "similarity_no_diag = np.copy(similarity_matrix)\n",
        "similarity_no_diag[mask] = -1\n",
        "\n",
        "idx = np.unravel_index(np.argmax(similarity_no_diag), similarity_no_diag.shape)\n",
        "cust1, cust2 = idx\n",
        "print(f\"\\nThe two most similar customers are Customer {cust1} and Customer {cust2} with a cosine similarity of {similarity_matrix[cust1, cust2]:.4f}.\")"
      ],
      "execution_count": null,
