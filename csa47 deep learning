        "    path = [start_pos]\n",
        "    pos = np.array(start_pos, dtype=float)\n",
        "    for _ in range(epochs):\n",
        "        grad = gradients(pos[0], pos[1])\n",
        "        pos -= lr * grad\n",
        "        path.append(pos.copy())\n",
        "    return np.array(path)\n",
        "\n",
        "def stochastic_gradient_descent(start_pos, lr, epochs, noise_level=1.5):\n",
        "    path = [start_pos]\n",
        "    pos = np.array(start_pos, dtype=float)\n",
        "    for _ in range(epochs):\n",
        "        # Add simulated stochastic noise to gradients\n",
        "        grad = gradients(pos[0], pos[1]) + np.random.normal(0, noise_level, 2)\n",
        "        pos -= lr * grad\n",
        "        path.append(pos.copy())\n",
        "    return np.array(path)\n",
        "\n",
        "def momentum_gradient_descent(start_pos, lr, beta, epochs):\n",
        "    path = [start_pos]\n",
        "    pos = np.array(start_pos, dtype=float)\n",
        "    velocity = np.zeros(2)\n",
        "    for _ in range(epochs):\n",
        "        grad = gradients(pos[0], pos[1])\n",
        "        velocity = beta * velocity + lr * grad\n",
