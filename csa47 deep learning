        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "np.random.seed(42)\n",
        "\n",
        "# Task 1: Perceptron with weighted sum, bias and step\n",
        "def step(z):\n",
        "    return (z >= 0).astype(int)\n",
        "\n",
        "def predict(X, w, b):\n",
        "    z = np.dot(X, w) + b\n",
        "    return step(z)\n",
        "\n",
        "# Task 2: Create 100 loan applications\n",
        "credit = np.random.randint(300, 851, 100)\n",
        "income_ratio = np.random.uniform(0.1, 0.9, 100)\n",
