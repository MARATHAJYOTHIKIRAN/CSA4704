        "# Normalize input values\n",
        "X = np.column_stack((credit / 850, income_ratio))\n",
        "\n",
        "# Loan approval rule (synthetic labels)\n",
        "y = ((X[:, 0] + X[:, 1]) >= 1.1).astype(int)\n",
        "\n",
        "# Perceptron training\n",
        "def train(X, y, epochs=30):\n",
        "    w = np.zeros(X.shape[1])\n",
        "    b = 0.0\n",
        "    history = []\n",
        "\n",
        "    for epoch in range(epochs):\n",
        "        errors = 0\n",
        "\n",
        "        for i in range(len(X)):\n",
        "            output = predict(X[i], w, b)\n",
        "            error = y[i] - output\n",
        "\n",
        "            # Perceptron learning rule\n",
        "            w = w + 0.1 * error * X[i]\n",
        "            b = b + 0.1 * error\n",
        "\n",
        "            if error != 0:\n",
        "                errors += 1\n",
        "\n",
        "        history.append(errors)\n",
        "        print(\"Epoch\", epoch + 1,\n",
        "              \"Updates:\", errors,\n",
        "              \"Weights:\", np.round(w, 3),\n",
        "              \"Bias:\", round(b, 3))\n",
        "\n",
        "        if errors == 0:\n",
