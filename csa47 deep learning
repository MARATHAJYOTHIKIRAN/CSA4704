        "# Task 4: Show a dense layer y = Wx + b manually for one customer\n",
        "\n",
        "# Take the 1st customer's genre rating as input vector x\n",
        "x = customer_genre[0, :].reshape(-1, 1) # Shape (5, 1)\n",
        "\n",
        "# Let the weights W be the transpose of Genre-Book matrix\n",
        "W = genre_book.T # Shape (4, 5)\n",
        "\n",
        "# Let b be a synthetic bias vector for the 4 books\n",
        "b = np.array([0.5, -0.2, 0.1, 0.4]).reshape(-1, 1) # Shape (4, 1)\n",
        "\n",
        "# Compute dense layer equation\n",
        "y = np.dot(W, x) + b\n",
        "\n",
        "print(\"Input vector x (Customer 0 genre vector) (5x1):\\n\", x)\n",
        "print(\"\\nWeight matrix W (Genre-Book transpose) (4x5):\\n\", np.round(W, 2))\n",
        "print(\"\\nBias vector b (4x1):\\n\", b)\n",
        "print(\"\\nOutput Vector y = Wx + b (Book recommendation scores) (4x1):\\n\", np.round(y, 2))"
      ],
