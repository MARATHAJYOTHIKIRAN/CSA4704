      "source": [
        "import numpy as np\n",
        "from scipy import stats\n",
        "\n",
        "data_skew_kurt = [2, 3, 3, 4, 4, 4, 5, 5, 6, 15]\n",
        "\n",
        "skewness = stats.skew(data_skew_kurt)\n",
