      "source": [
        "# Task 2: Compute matrix product, transpose, inverse and element-wise operations\n",
        "\n",
        "# Score matrix (6x4) representing customer scores for books\n",
        "score_matrix = np.dot(customer_genre, genre_book)\n",
        "print(\"Score Matrix (Customer-Book Scores via Dot Product) (6x4):\\n\", np.round(score_matrix, 2))\n",
        "\n",
        "# Transpose of score matrix\n",
        "score_matrix_T = score_matrix.T\n",
        "print(\"\\nTranspose of Score Matrix (4x6):\\n\", np.round(score_matrix_T, 2))\n",
        "\n",
        "# Pseudo-inverse of Customer-Genre matrix (since it is non-square and direct inverse is invalid)\n",
        "pseudo_inverse = np.linalg.pinv(customer_genre)\n",
        "print(\"\\nPseudo-inverse of Customer-Genre Matrix (5x6):\\n\", np.round(pseudo_inverse, 2))\n",
        "\n",
        "# Element-wise operation: normalize ratings by maximum rating\n",
        "normalized_customer_genre = customer_genre / 5.0\n",
        "print(\"\\nNormalized Customer Ratings (Element-wise division by 5):\\n\", normalized_customer_genre)"
      ],
