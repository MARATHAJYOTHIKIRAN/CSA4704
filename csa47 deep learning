        "delivery_time = (15 + 1.2 * distance + 4.5 * traffic_index + 0.1 * package_weight\n",
        "                 + 2.0 * np.sin(time_of_day) + np.random.normal(0, 5, n_samples))\n",
        "\n",
        "X_dataset = np.stack([distance, traffic_index, package_weight, time_of_day], axis=1)\n",
        "y_dataset = delivery_time\n",
        "\n",
        "scaler = StandardScaler()\n",
        "X_scaled = scaler.fit_transform(X_dataset)\n",
